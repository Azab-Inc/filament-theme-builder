{
	{$CADDY_GLOBAL_OPTIONS}

	admin {$CADDY_SERVER_ADMIN_HOST}:{$CADDY_SERVER_ADMIN_PORT}

	frankenphp {
		worker {
			file "{$APP_PUBLIC_PATH}/frankenphp-worker.php"
			{$CADDY_SERVER_WORKER_DIRECTIVE}
		}
	}
}

{$CADDY_SERVER_SERVER_NAME} {
	log {
		level {$CADDY_SERVER_LOG_LEVEL}
		format {$CADDY_SERVER_LOGGER}
	}

	route {
		@vite_hot path /hot
		respond @vite_hot 404

		@laravel path /demo /demo/* /api /api/* /build/* /storage/* /fonts/* /css/filament/* /js/filament/* /_debugbar/* /livewire* /favicon.ico /robots.txt
		root * "{$APP_PUBLIC_PATH}"
		php_server @laravel {
			index frankenphp-worker.php
			try_files {path} frankenphp-worker.php
			resolve_root_symlink
		}

		@builder_assets path /assets/*
		handle @builder_assets {
			root * /var/www/html/builder-dist
			header Cache-Control "public, max-age=31536000, immutable"
			file_server
		}

		handle {
			root * /var/www/html/builder-dist
			try_files {path} /index.html
			file_server
		}
	}
}
